# Chaîne de connexion du projet Neon « ebok » (schéma medias créé automatiquement).
# Console Neon → ton projet → Connection string (avec ?sslmode=require).
# Tant qu'elle est absente : le site reste statique, le formulaire propose l'e-mail.
DATABASE_URL=

# Identité — CLERK (compte unique de la galaxie EBOK, instance clerk.ebok.fr).
# La clé publishable est PUBLIQUE (préfixe NEXT_PUBLIC_) ; la secret key ne doit
# JAMAIS être versionnée. Les deux valeurs sont les mêmes pour toutes les apps.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZWJvay5mciQ
CLERK_SECRET_KEY=

# (Optionnel) e-mails admin additionnels, séparés par des virgules.
# marley.ebok@gmail.com est admin d'office.
ADMIN_EMAILS=
